# Telegram
TELEGRAM_BOT_TOKEN=123456:replace_me

# Runtime mode:
# - polling: simplest local/server mode. Uses Telegram long polling.
# - webhook: for a VPS/server behind HTTPS reverse proxy. Still needs a persistent worker.
TELEGRAM_RUN_MODE=polling
WEBHOOK_URL=
WEBHOOK_LISTEN=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET_TOKEN=

# Optional. If empty, run /start in the target group once and the bot will remember it.
# For supergroups it usually looks like -1001234567890.
TELEGRAM_CHAT_ID=

# Binance Futures symbols. You can also toggle them in Telegram.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,HYPEUSDT

# Binance intervals. Create Telegram topics for these and bind them with /bind 1m, /bind 3m, etc.
TIMEFRAMES=1m,3m,5m,15m,30m,1h,2h,4h

# Optional static topic mapping if you already know message_thread_id values.
# Example: TOPIC_THREADS=1m:11,3m:12,5m:13,15m:14
TOPIC_THREADS=

# Polling and indicator settings
POLL_SECONDS=20
KLINE_LIMIT=220

# L2 KDJ TradingView defaults from the Pine Script:
# n1=18, m1=4, m2=4, BuyAlertLimit=0, SellAlertLimit=100.
L2_KDJ_N1=18
L2_KDJ_M1=4
L2_KDJ_M2=4
BUY_ALERT_LIMIT=0
SELL_ALERT_LIMIT=100

# Gauge shown by the "indicator now" button.
INDICATOR_SCALE_MIN=-10
INDICATOR_SCALE_MAX=110

# Volume context from Binance USD-M Futures klines.
VOLUME_MA_PERIOD=20
MIN_VOLUME_RATIO=0.80
STRONG_VOLUME_RATIO=1.30
REQUIRE_VOLUME_FOR_CONFIRMED=false

# Prevent repeated ordinary LONG/SHORT alerts on the same symbol/timeframe.
SIGNAL_COOLDOWN_CANDLES=3

# Persistent state file.
STATE_FILE=data/state.json

# Signal charts. If chart rendering fails, the bot falls back to a text signal.
CHARTS_ENABLED=true
CHART_CANDLES=80
CHART_WIDTH=12
CHART_HEIGHT=7

# Combined timeframe signals.
COMBINED_DEFAULT_TIMEFRAMES=1m,3m,5m,15m
COMBINED_DEFAULT_RULE=all_match
